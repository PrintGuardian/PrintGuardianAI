# PrintGuardianAI configuration
APP_NAME=PrintGuardianAI

# Optional local vision agent. Keep disabled until Ollama and the model are installed.
AI_AGENT_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
VISION_MODEL=qwen3-vl:2b-instruct
AI_INTERVAL_SECONDS=120
AI_TIMEOUT_SECONDS=180
AI_MIN_CONFIDENCE=0.65
AI_ALERT_COOLDOWN_SECONDS=1800
AI_MAX_IMAGE_SIDE=768
AI_CONTEXT_TOKENS=2048

# Use a locally connected USB / Raspberry Pi camera.
CAMERA_INDEX=0
# Or provide an HTTP snapshot URL (for example from OctoPrint).
CAMERA_SNAPSHOT_URL=
# Number of MJPEG frames sent to the dashboard per second.
CAMERA_STREAM_FPS=5

# Control endpoint authentication. Generate a unique secret, e.g. `openssl rand -hex 32`.
# Leave empty to keep the STOP PRINT endpoint disabled.
CONTROL_API_TOKEN=

# OctoPrint integration
OCTOPRINT_URL=
OCTOPRINT_API_KEY=
REQUEST_TIMEOUT_SECONDS=5

# Events are stored locally in JSON Lines format.
EVENT_LOG_PATH=data/events.jsonl

# Keep disabled until the detector has been validated on your printer.
AUTO_STOP_ENABLED=false
AUTO_STOP_CONFIDENCE=0.90
